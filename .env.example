# When "true", robots.txt allows indexing and sitemap.xml is populated,
# but ONLY for the production host (dastyare.social / www.dastyare.social).
# Set to "false" for local development and preview deployments.
NEXT_PUBLIC_ALLOW_INDEXING=false

# PostHog product analytics
# Get the project token from PostHog
# Leave empty to disable event capture
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ActivePieces "Website — Workflow" webhook (homepage waitlist)
WEBHOOK_URL=https://your-webhook-endpoint.example.com

# PostHog bootstrap only (bun run bootstrap:posthog): phx_ key with admin scope.
PH_PROJECT_ID=581705
PH_PERSONAL_API_KEY="replace-with-phx-personal-api-key-with-admin-scope"

# Saved heatmaps target (used only by bootstrap:posthog to skip the prompt).
PH_DEPLOYED_URL=https://dastyare.social